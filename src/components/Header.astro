---
import { GraduationCap } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
		<!-- Brand Logo -->
		<a class="flex items-center gap-3 group" href="#">
			<div class="w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
				<GraduationCap class="w-5 h-5" />
			</div>
			<div class="flex flex-col">
				<span class="font-extrabold text-xl leading-none tracking-tight text-brand-900 select-none">MSVC</span>
				<span class="text-[10px] text-slate-400 font-medium tracking-wider uppercase mt-1">Malaysia Student Visa Consultancy</span>
			</div>
		</a>

		<!-- Desktop Navigation Menu -->
		<nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
			<a class="text-brand-600 hover:text-brand-700 transition-colors" href="#">Home</a>
			<a class="hover:text-brand-600 transition-colors" href="#destinations">Destinations</a>
			<a class="hover:text-brand-600 transition-colors" href="#services">Services</a>
			<a class="hover:text-brand-600 transition-colors" href="#about">About</a>
			<a class="hover:text-brand-600 transition-colors" href="#blog">Blog</a>
			<a class="hover:text-brand-600 transition-colors" href="#contact">Contact</a>
		</nav>

		<!-- Right Header Actions -->
		<div class="flex items-center gap-3">
			<Button href="#consultation" variant="primary" size="md">
				Book Consultation
			</Button>
		</div>
	</div>
</header>

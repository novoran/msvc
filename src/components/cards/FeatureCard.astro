---
export interface Props {
	title: string;
	desc: string;
	icon: any;
	class?: string;
}

const { title, desc, icon: Icon, class: className = '' } = Astro.props;
---

<div
	class:list={[
		'bg-white p-6 rounded-2xl border border-slate-100 flex items-start gap-4',
		className,
	]}
>
	<div class="w-11 h-11 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center shrink-0">
		<Icon class="w-5 h-5" />
	</div>
	<div>
		<h3 class="font-bold text-slate-900 text-sm mb-1">{title}</h3>
		<p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
	</div>
</div>

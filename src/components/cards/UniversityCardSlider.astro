---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import type { UniversityData } from '@/data/recruitment';
import {
	MapPin,
	CalendarCheck,
	CircleCheck,
	DollarSign,
	GraduationCap,
	Award,
	ChevronLeft,
	ChevronRight,
	ExternalLink,
	ArrowRight,
} from '@lucide/astro';

export interface Props {
	university: UniversityData;
	class?: string;
}

const { university: u, class: className = '' } = Astro.props;
---

<article
	class:list={[
		'bg-white rounded-3xl border border-slate-200/90 overflow-hidden hover:border-brand-300 transition-all flex flex-col lg:flex-row university-compact-card',
		className,
	]}
	data-university-id={u.id}
>
	<!-- Left / Top: Interactive Embla Image Slider -->
	<div class="relative lg:w-5/12 min-h-[260px] sm:min-h-[300px] lg:min-h-full bg-slate-900 overflow-hidden flex flex-col justify-between">
		<!-- Embla Viewport -->
		<div class="embla w-full h-full absolute inset-0 overflow-hidden cursor-grab active:cursor-grabbing">
			<div class="embla__container flex h-full">
				{u.galleryImages.map((imgUrl, idx) => (
					<div class="embla__slide relative flex-[0_0_100%] min-w-0 h-full">
						<img
							src={imgUrl}
							alt={`${u.name} campus view ${idx + 1}`}
							class="w-full h-full object-cover select-none"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-linear-to-t from-slate-950/80 via-slate-950/20 to-transparent pointer-events-none" />
					</div>
				))}
			</div>
		</div>

		<!-- Top Floating Badges -->
		<div class="relative z-10 p-4 flex flex-wrap gap-2 pointer-events-none">
			<Badge variant="dark" size="xs">{u.badge}</Badge>
			{u.scholarshipAvailable && (
				<Badge variant="emerald" size="xs" iconLeading={Award}>
					Scholarship Open
				</Badge>
			)}
		</div>

		<!-- Bottom Slider Controls & Dots -->
		<div class="relative z-10 p-4 flex items-center justify-between pointer-events-auto">
			<!-- Slider Arrows -->
			<div class="flex items-center gap-1.5">
				<button
					type="button"
					aria-label="Previous slide"
					class="embla__prev w-8 h-8 rounded-full bg-black/40 hover:bg-black/70 backdrop-blur-md text-white flex items-center justify-center transition-colors cursor-pointer border border-white/10"
				>
					<ChevronLeft class="w-4 h-4" />
				</button>
				<button
					type="button"
					aria-label="Next slide"
					class="embla__next w-8 h-8 rounded-full bg-black/40 hover:bg-black/70 backdrop-blur-md text-white flex items-center justify-center transition-colors cursor-pointer border border-white/10"
				>
					<ChevronRight class="w-4 h-4" />
				</button>
			</div>

			<!-- Dots Pagination Indicator -->
			<div class="embla__dots flex items-center gap-1.5 bg-black/40 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/10">
				{u.galleryImages.map((_, idx) => (
					<button
						type="button"
						aria-label={`Go to slide ${idx + 1}`}
						data-slide-index={idx}
						class:list={[
							'embla__dot w-2 h-2 rounded-full transition-all cursor-pointer',
							idx === 0 ? 'bg-white w-4' : 'bg-white/40',
						]}
					/>
				))}
			</div>
		</div>
	</div>

	<!-- Right / Bottom: Compact Academic Overview & Requirements -->
	<div class="p-6 sm:p-7 lg:w-7/12 flex flex-col justify-between">
		<div>
			<!-- Title & Campus Subtitle -->
			<div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-2">
				<h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
					{u.name}
				</h3>
				<a
					href={u.officialWebsite}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors shrink-0"
				>
					<span>Official Site</span>
					<ExternalLink class="w-3.5 h-3.5" />
				</a>
			</div>

			<div class="flex items-center gap-1.5 text-xs text-slate-500 mb-3 font-medium">
				<MapPin class="w-3.5 h-3.5 text-brand-600 shrink-0" />
				<span>{u.location} • Campuses: {u.campuses.join(', ')}</span>
			</div>

			<p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-5">
				{u.overview}
			</p>

			<!-- Compact Meta Grid -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5 pt-3.5 border-t border-slate-100 text-xs">
				<!-- Intakes -->
				<div>
					<span class="text-slate-400 font-medium block text-xs mb-1.5 flex items-center gap-1">
						<CalendarCheck class="w-3.5 h-3.5 text-brand-600" />
						Upcoming Intakes
					</span>
					<div class="flex flex-wrap gap-1.5">
						{u.intakes.map((intake) => (
							<Badge variant="blue" size="xs">
								{intake}
							</Badge>
						))}
					</div>
				</div>

				<!-- Tuition Fees -->
				<div>
					<span class="text-slate-400 font-medium block text-xs mb-1.5 flex items-center gap-1">
						<DollarSign class="w-3.5 h-3.5 text-emerald-600" />
						Est. Tuition Fees
					</span>
					<p class="font-bold text-slate-800 text-xs sm:text-sm">{u.tuitionRange}</p>
				</div>

				<!-- Admission Criteria -->
				<div class="sm:col-span-2">
					<span class="text-slate-400 font-medium block text-xs mb-1 flex items-center gap-1">
						<GraduationCap class="w-3.5 h-3.5 text-brand-600" />
						Minimum Entry Criteria
					</span>
					<p class="font-medium text-slate-700 text-xs leading-normal">{u.minRequirement}</p>
				</div>

				<!-- Popular Faculties -->
				<div class="sm:col-span-2">
					<span class="text-slate-400 font-medium block text-xs mb-1.5 flex items-center gap-1">
						<CircleCheck class="w-3.5 h-3.5 text-brand-600" />
						Popular Programs
					</span>
					<div class="flex flex-wrap gap-1.5">
						{u.popularFields.map((field) => (
							<Badge variant="slate" size="xs">
								{field}
							</Badge>
						))}
					</div>
				</div>
			</div>
		</div>

		<!-- Action Footer -->
		<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-3.5 border-t border-slate-100">
			<span class="text-[11px] text-slate-400 font-medium">
				⚡ Free offer letter assessment & scholarship review
			</span>
			<Button
				href={u.applyUrl}
				target="_blank"
				rel="noopener noreferrer"
				variant="primary"
				size="sm"
				iconTrailing={ArrowRight}
			>
				Apply to {u.shortName}
			</Button>
		</div>
	</div>
</article>

<script>
	import EmblaCarousel from 'embla-carousel';

	function initSliders() {
		const cards = document.querySelectorAll<HTMLElement>('.university-compact-card');

		cards.forEach((card) => {
			const emblaNode = card.querySelector<HTMLElement>('.embla');
			const prevBtn = card.querySelector<HTMLButtonElement>('.embla__prev');
			const nextBtn = card.querySelector<HTMLButtonElement>('.embla__next');
			const dots = card.querySelectorAll<HTMLButtonElement>('.embla__dot');

			if (!emblaNode) return;

			const embla = EmblaCarousel(emblaNode, {
				loop: true,
				align: 'start',
				containScroll: 'trimSnaps',
			});

			const updateDots = () => {
				const selectedIndex = embla.selectedScrollSnap();
				dots.forEach((dot, idx) => {
					if (idx === selectedIndex) {
						dot.classList.add('bg-white', 'w-4');
						dot.classList.remove('bg-white/40', 'w-2');
					} else {
						dot.classList.remove('bg-white', 'w-4');
						dot.classList.add('bg-white/40', 'w-2');
					}
				});
			};

			prevBtn?.addEventListener('click', () => embla.scrollPrev());
			nextBtn?.addEventListener('click', () => embla.scrollNext());

			dots.forEach((dot, idx) => {
				dot.addEventListener('click', () => embla.scrollTo(idx));
			});

			embla.on('select', updateDots);
			embla.on('init', updateDots);
		});
	}

	// Initialize on initial load and View Transitions
	initSliders();
	document.addEventListener('astro:page-load', initSliders);
</script>

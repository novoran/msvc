---
import { ArrowRight } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
---

<section class="py-14 bg-brand-900 text-white relative overflow-hidden" id="consultation">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
			<div class="max-w-2xl">
				<span class="text-xs font-bold text-blue-300 tracking-wider uppercase mb-1.5 block">Take the First Step</span>
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight">
					Start Your Malaysia Study Journey Today
				</h2>
				<p class="text-blue-100/80 text-sm sm:text-base mt-2">
					Get free profile assessment, course recommendation, and step-by-step EMGS visa guidelines from accredited Malaysian university specialists.
				</p>
			</div>
			<div class="shrink-0">
				<Button href="#consultation" variant="white" size="lg" iconTrailing={ArrowRight}>
					Book Free Consultation
				</Button>
			</div>
		</div>
	</div>
</section>

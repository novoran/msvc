---
import { ArrowRight, CreditCard, Send, ShieldAlert, Stamp } from '@lucide/astro';
import { contactConfig } from '@/utils/contact';

const steps = [
	{
		number: '01',
		title: 'EMGS Fee Payment',
		desc: 'Pay required EMGS and related visa processing charges (estimated RM 3,300 to RM 6,000 depending on university).',
		icon: CreditCard,
		highlight: 'RM 3,300 - RM 6,000 Est.',
	},
	{
		number: '02',
		title: 'EMGS Application',
		desc: 'Systematic compilation and preparation of all required legal and academic documents for EMGS processing.',
		icon: Send,
		highlight: 'Document Vetting',
	},
	{
		number: '03',
		title: 'Supporting Documents',
		desc: 'Prepare financial bank statements, income source declarations, Statement of Purpose (SOP), and sponsor documents.',
		icon: ShieldAlert,
		highlight: 'Financial Proof & SOP',
	},
	{
		number: '04',
		title: 'eVAL & Single Entry Visa',
		desc: 'Receive official electronic Visa Approval Letter (eVAL) and complete the Single Entry Visa (SEV) before departure.',
		icon: Stamp,
		highlight: 'Immigration Clearance',
	},
];
---

<section class="py-20 bg-white border-t border-slate-100" id="emgs">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
			<div>
				<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Visa & Application Flow</span>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Malaysia Student Visa (EMGS) Process</h2>
				<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-2xl">
					A transparent roadmap from initial EMGS fee payment to official eVAL approval and Single Entry Visa issuance.
				</p>
			</div>
			<a
				href={contactConfig.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors group"
			>
				<span>Get Visa Assistance</span>
				<ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
			</a>
		</div>

		<!-- 4 Core EMGS Steps Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
			{steps.map((s) => {
				const Icon = s.icon;
				return (
					<div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 hover:border-brand-200 hover:bg-slate-50/80 transition-all flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between mb-4">
								<span class="text-xs font-black font-mono text-brand-600 px-2.5 py-0.5 rounded-md bg-white border border-slate-200">
									Step {s.number}
								</span>
								<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center">
									<Icon class="w-5 h-5" />
								</div>
							</div>
							<h3 class="font-bold text-slate-900 text-base leading-snug mb-2">{s.title}</h3>
							<p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">{s.desc}</p>
						</div>
						<div class="pt-3 border-t border-slate-200">
							<span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md inline-block">
								{s.highlight}
							</span>
						</div>
					</div>
				);
			})}
		</div>

		<!-- Transparency Notice Callout -->
		<div class="p-5 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200 flex items-start sm:items-center gap-4">
			<div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
				<ShieldAlert class="w-5 h-5" />
			</div>
			<div>
				<h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-0.5">
					Transparency & Advisory Notice
				</h4>
				<p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
					Our initial university admissions assessment and student visa advisory services are provided completely free of charge. Official university tuition, EMGS statutory charges, health screening, and immigration endorsement fees remain payable directly to the respective institutions and government authorities.
				</p>
			</div>
		</div>
	</div>
</section>

---
import { ArrowRight } from '@lucide/astro';
import BlogCard from '@/components/cards/BlogCard.astro';

export interface BlogPostItem {
	title: string;
	date: string;
	tag: string;
	image: string;
	href?: string;
}

export interface Props {
	blogPosts: BlogPostItem[];
}

const { blogPosts } = Astro.props;
---

<section class="py-20 bg-white" id="blog">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
			<div>
				<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Latest Updates</span>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Insights & Visa Guidelines</h2>
				<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-xl">
					Get the latest immigration announcements, EMGS criteria, and Malaysian campus insights.
				</p>
			</div>
			<a class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors group" href="#">
				<span>View All Articles</span>
				<ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			{blogPosts.map((post) => (
				<BlogCard
					title={post.title}
					date={post.date}
					tag={post.tag}
					image={post.image}
					href={post.href}
				/>
			))}
		</div>
	</div>
</section>

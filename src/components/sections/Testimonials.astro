---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Star, StarHalf } from '@lucide/astro';

export interface TestimonialItem {
	quote: string;
	name: string;
	country: string;
	rating?: number;
	avatar: ImageMetadata | string;
}

export interface Props {
	testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
---

<section class="py-20 bg-white border-t border-slate-100">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12">
			<div>
				<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Student Stories</span>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">What Our Students Say</h2>
				<p class="text-slate-500 text-sm sm:text-base mt-2">
					Real stories. Real dreams. Hear from students who successfully obtained their Malaysian student visas with MSVC.
				</p>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			{testimonials.map((t) => {
				const rating = t.rating ?? 5;
				const fullStars = Math.floor(rating);
				const hasHalfStar = rating % 1 !== 0;

				return (
					<div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-100 card-shadow card-hover flex flex-col justify-between">
						<div>
							<p class="text-slate-600 text-sm leading-relaxed mb-6 italic">"{t.quote}"</p>
						</div>
						<div class="flex items-center gap-3.5 pt-4 border-t border-slate-100">
							{typeof t.avatar === 'string' ? (
								<Image
									alt={t.name}
									class="w-12 h-12 rounded-full object-cover"
									src={t.avatar}
									width={48}
									height={48}
									loading="lazy"
								/>
							) : (
								<Image
									alt={t.name}
									class="w-12 h-12 rounded-full object-cover"
									src={t.avatar}
									width={48}
									height={48}
									loading="lazy"
								/>
							)}
							<div>
								<h3 class="font-bold text-slate-900 text-sm">{t.name}</h3>
								<p class="text-[11px] text-slate-400 font-medium">{t.country}</p>
								<div class="flex text-amber-400 text-[10px] items-center gap-0.5 mt-1">
									{Array.from({ length: fullStars }).map(() => (
										<Star class="w-3 h-3 fill-amber-400 text-amber-400" />
									))}
									{hasHalfStar && (
										<StarHalf class="w-3 h-3 fill-amber-400 text-amber-400" />
									)}
									<span class="text-[10px] font-bold text-slate-500 ml-1 leading-none">{rating}</span>
								</div>
							</div>
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>

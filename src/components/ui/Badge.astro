---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
	variant?: 'brand' | 'blue' | 'slate';
	class?: string;
}

const { variant = 'brand', class: className = '', ...rest } = Astro.props;

const variants = {
	brand: 'bg-blue-100/70 border-blue-200/50 text-brand-700',
	blue: 'bg-brand-600 text-white',
	slate: 'bg-slate-100 text-slate-700 border-slate-200',
};
---

<span
	class:list={[
		'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border text-xs font-bold tracking-wide uppercase',
		variants[variant],
		className,
	]}
	{...rest}
>
	<slot />
</span>

---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'white';
export type ButtonSize = 'sm' | 'md' | 'lg' | 'icon';

export interface Props extends HTMLAttributes<'button'> {
	variant?: ButtonVariant;
	size?: ButtonSize;
	href?: string;
	class?: string;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	class: className = '',
	...rest
} = Astro.props;

const baseStyles =
	'inline-flex items-center justify-center font-semibold transition-all rounded-full select-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 disabled:pointer-events-none disabled:opacity-50';

const variants: Record<ButtonVariant, string> = {
	primary:
		'bg-brand-600 text-white hover:bg-brand-700 shadow-md shadow-brand-600/20 active:scale-[0.98]',
	secondary:
		'bg-blue-50 text-brand-700 hover:bg-blue-100/80 border border-blue-200/50',
	outline:
		'bg-white border border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50',
	ghost:
		'text-brand-600 hover:text-brand-700 hover:bg-blue-50/50',
	white:
		'bg-white text-brand-900 hover:bg-blue-50 shadow-lg shadow-black/10 active:scale-[0.98]',
};

const sizes: Record<ButtonSize, string> = {
	sm: 'text-xs px-3.5 py-1.5 gap-1.5',
	md: 'text-sm px-6 py-3 gap-2',
	lg: 'text-sm sm:text-base px-7 py-3.5 gap-2.5 shadow-lg shadow-brand-600/25',
	icon: 'w-8 h-8 p-0 rounded-full',
};

const classes = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

{
	href ? (
		<a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
			<slot />
		</a>
	) : (
		<button class={classes} {...rest}>
			<slot />
		</button>
	)
}

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { Home, Compass, MessageCircle, ArrowRight, GraduationCap, FileCheck } from '@lucide/astro';
import { contactConfig } from '@/utils/contact';

const quickLinks = [
	{
		title: 'Explore Malaysian Universities',
		desc: 'Browse top public & private institutions, intake dates, and tuition fees.',
		href: '/destination',
		icon: GraduationCap,
	},
	{
		title: 'EMGS Visa & Admission Guide',
		desc: 'Learn about our 24h offer letter processing and 100% VAL clearance process.',
		href: '/#process',
		icon: FileCheck,
	},
	{
		title: 'Talk to an Expert Counselor',
		desc: 'Chat directly on WhatsApp to evaluate your profile, CGPA, and study gaps.',
		href: contactConfig.whatsappUrl,
		icon: MessageCircle,
		external: true,
	},
];
---

<BaseLayout
	title="Page Not Found (404) | MSVC - Malaysia Student Visa Consultancy"
	description="The page you are looking for doesn't exist or has been moved. Explore top Malaysian universities, admission requirements, or contact our counselors directly."
>
	<section class="relative overflow-hidden py-16 sm:py-24 lg:py-28 bg-linear-to-b from-white via-blue-50/20 to-slate-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl mx-auto text-center">
				<Badge variant="warning" class="mb-4">
					Error 404 • Page Not Found
				</Badge>

				<h1 class="text-6xl sm:text-7xl lg:text-8xl font-black text-brand-900 tracking-tight leading-none mb-4">
					4<span class="text-brand-600">0</span>4
				</h1>

				<h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 tracking-tight mb-4">
					Looks like this pathway doesn't exist
				</h2>

				<p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
					The link you clicked might be outdated or the page has moved. Don't worry, your journey to studying in Malaysia is still right on track!
				</p>

				<div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-14">
					<Button href="/" variant="primary" size="lg" class="shadow-md shadow-brand-600/20">
						<Home class="w-4 h-4 mr-2" />
						Back to Homepage
					</Button>
					<Button href="/destination" variant="outline" size="lg">
						<Compass class="w-4 h-4 mr-2" />
						Browse Destinations
					</Button>
				</div>
			</div>

			<!-- Quick Helpful Links -->
			<div class="max-w-3xl mx-auto">
				<div class="bg-white rounded-2xl border border-slate-100 p-6 sm:p-8 card-shadow">
					<h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-5 text-center sm:text-left">
						Suggested Destinations & Quick Links
					</h3>

					<div class="grid grid-cols-1 gap-4">
						{
							quickLinks.map((item) => (
								<a
									href={item.href}
									target={item.external ? '_blank' : undefined}
									rel={item.external ? 'noopener noreferrer' : undefined}
									class="group flex items-start gap-4 p-4 rounded-xl border border-slate-100 hover:border-brand-200 hover:bg-slate-50/70 transition-all"
								>
									<div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0 group-hover:bg-brand-600 group-hover:text-white transition-colors">
										<item.icon class="w-5 h-5" />
									</div>
									<div class="flex-1 min-w-0">
										<div class="flex items-center justify-between gap-2">
											<h4 class="text-base font-semibold text-slate-900 group-hover:text-brand-600 transition-colors">
												{item.title}
											</h4>
											<ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-brand-600 group-hover:translate-x-1 transition-all shrink-0" />
										</div>
										<p class="text-sm text-slate-500 mt-1 leading-relaxed">
											{item.desc}
										</p>
									</div>
								</a>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

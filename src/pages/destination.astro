---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { contactConfig } from '@/utils/contact';
import {
	CircleCheck,
	Clock,
	Award,
	FileText,
	Sparkles,
	ShieldCheck,
	Building,
	Mail,
	GraduationCap,
	Calendar,
	Briefcase,
	ChevronRight,
	Globe,
	Landmark,
	ArrowRight,
} from '@lucide/astro';

const quickNavLinks = [
	{ label: 'Why Malaysia', href: '#why-malaysia' },
	{ label: 'Universities', href: '#universities' },
	{ label: 'Courses & Fees', href: '#courses' },
	{ label: 'Costs & Living', href: '#costs' },
	{ label: 'Scholarships', href: '#scholarships' },
	{ label: 'Requirements', href: '#requirements' },
	{ label: 'Intakes', href: '#intakes' },
	{ label: 'How to Apply', href: '#how-to-apply' },
	{ label: 'Documents', href: '#documents' },
	{ label: 'Careers', href: '#work-opportunities' },
	{ label: 'FAQs', href: '#faq' },
];

const steps = [
	{
		step: '01',
		title: 'Free Profile & Document Review',
		desc: 'Send your academic certificates (SSC, HSC, transcripts) to MSVC. We verify eligibility for your target program within 24 hours.',
	},
	{
		step: '02',
		title: 'Fast-Track Offer Letter (LOA)',
		desc: 'We submit your application directly to the university admissions board to secure your unconditional or conditional Offer Letter in 24 hours.',
	},
	{
		step: '03',
		title: 'EMGS Visa Approval Letter (VAL)',
		desc: 'Our visa specialists lodge your EMGS application with full medical report and immigration vetting. Track your yellow/green approval bar.',
	},
	{
		step: '04',
		title: 'Single Entry Visa (e-Visa) & Fly',
		desc: 'Receive your eVAL, apply for e-Visa at the Malaysian High Commission, book flights, and receive MSVC airport pickup assistance.',
	},
];

const perks = [
	{
		icon: Clock,
		title: '24-Hour Offer Letters',
		desc: 'Direct liaison with university admission desks means priority processing without third-party bottlenecks.',
	},
	{
		icon: Award,
		title: 'Up to 50% Scholarships',
		desc: 'Merit-based scholarships and fee waivers assessed directly upon submitting your application with MSVC.',
	},
	{
		icon: ShieldCheck,
		title: '100% EMGS Compliance',
		desc: 'Error-free document preparation guarantees prompt VAL processing by Education Malaysia Global Services.',
	},
	{
		icon: Building,
		title: 'Hostel & Airport Meet',
		desc: 'Airport pick-up from KLIA 1/2 and confirmed on-campus or partner student accommodation before you depart.',
	},
];

const whyStudyMalaysia = [
	{
		title: 'Educational Excellence and Recognition',
		desc: 'Malaysia offers high-quality education through world-class universities providing impactful education. Malaysian degrees are internationally recognized and highly sought after by global employers, with many institutions ranking among the top 200 globally.',
	},
	{
		title: 'Affordable Education Costs',
		desc: 'Tuition and living costs in Malaysia are highly affordable compared to Western destinations—nearly comparable to private universities in Bangladesh while conferring a globally recognized international qualification.',
	},
	{
		title: 'International Degree Options & UK/AU Campuses',
		desc: 'Top-ranked UK and Australian universities operate branch campuses across Malaysia. Students can graduate with authentic British or Australian credentials at a fraction of the onshore cost.',
	},
	{
		title: 'Cultural Familiarity and High Safety',
		desc: 'Ranked the 2nd most peaceful country in Asia and 10th worldwide. A multicultural, welcoming society with accessible halal food, dynamic student lifestyle, and zero language barrier since English is widely used.',
	},
	{
		title: 'Part-Time Work & Swift Immigration',
		desc: 'International students are eligible for legal part-time employment during semesters and vacations. Seamless EMGS immigration procedures yield rapid student visa clearance for Bangladeshi applicants.',
	},
	{
		title: 'Global Credit Transfer Opportunities',
		desc: 'Malaysian universities offer structured 1+2 or 2+1 credit transfer pathways to Australia, Canada, the UK, and the USA for students wishing to complete their final years in the West.',
	},
];

const popularCourses = [
	{
		name: 'MBA (Master of Business Administration)',
		level: "Master's",
		feeMYR: 'RM 30,000 - 70,000+',
		feeBDT: 'BDT 777,000 - 1,813,000+',
		universities: "Taylor's University, SEGi University, HELP University, APU",
	},
	{
		name: 'Computer Science & Software Engineering',
		level: "Bachelor's / Master's",
		feeMYR: 'RM 15,000 - 60,000',
		feeBDT: 'BDT 388,500 - 1,554,000',
		universities: "Taylor's University, APU, University of Malaya",
	},
	{
		name: 'Engineering (Mechanical, Civil, Electrical)',
		level: "Bachelor's / Master's",
		feeMYR: 'RM 20,000 - 60,000',
		feeBDT: 'BDT 518,000 - 1,554,000',
		universities: 'Universiti Teknologi Malaysia, Universiti Putra Malaysia',
	},
	{
		name: 'Medicine & Healthcare Sciences (MBBS)',
		level: "Bachelor's / Master's",
		feeMYR: 'RM 40,000 - 80,000',
		feeBDT: 'BDT 1,036,000 - 2,072,000',
		universities: "University of Malaya, Taylor's University, SEGi University",
	},
	{
		name: 'Banking, Accounting & Finance',
		level: "Bachelor's / Master's",
		feeMYR: 'RM 20,000 - 60,000',
		feeBDT: 'BDT 518,000 - 1,554,000',
		universities: "Taylor's University, APU, University of Malaya",
	},
];

const publicUniversities = [
	{ name: 'University of Malaya (UM)', rank: '#58 Globally', note: 'Top public research university in Malaysia' },
	{ name: 'Universiti Kebangsaan Malaysia (UKM)', rank: '#126 Globally', note: 'National University with leading STEM faculties' },
	{ name: 'Universiti Sains Malaysia (USM)', rank: '#134 Globally', note: 'Premier apex research institution' },
	{ name: 'Universiti Putra Malaysia (UPM)', rank: '#134 Globally', note: 'Global leader in agriculture and engineering' },
	{ name: 'Universiti Teknologi Malaysia (UTM)', rank: '#153 Globally', note: 'Pioneer technical and innovation campus' },
	{ name: 'Universiti Teknologi Petronas (UTP)', rank: '#251 Globally', note: 'Industry-partnered energy and computing hub' },
];

const privateUniversities = [
	{ name: "Taylor's University", rank: '#253 Globally', note: 'Top non-government university in Southeast Asia' },
	{ name: 'Sunway University', rank: '#410 Globally', note: 'Rapidly rising institution with Lancaster dual awards' },
	{ name: 'Asia Pacific University (APU)', rank: 'Premier Tech Tier', note: 'Malaysia premier digital technology university' },
	{ name: 'Lincoln University College', rank: 'Top Tier Medical/Health', note: 'Renowned for healthcare, medicine & nursing' },
	{ name: 'INTI International University', rank: 'UK/US Dual Degrees', note: 'Direct partnerships with Hertfordshire & SNHU' },
];

const branchCampuses = [
	{ name: 'University of Nottingham Malaysia', rank: 'UK Top 20 / World #100', note: 'Direct UK degree awarded in Semenyih campus' },
	{ name: 'University of Wollongong Malaysia (UOW)', rank: 'Australia Top 10 / World #167', note: 'Prestigious Australian curriculum & credentials' },
	{ name: 'Swinburne University of Technology Malaysia', rank: 'Australia Top Tier / World #291', note: 'Sarawak branch campus with Melbourne degrees' },
	{ name: 'Monash University Malaysia', rank: 'Group of Eight / World #37', note: 'Sunway campus offering Australian Group of 8 degrees' },
];

const privateIntakes = [
	{ session: 'April Session', deadline: 'February', recommended: '3 months prior' },
	{ session: 'June Session', deadline: 'April', recommended: '3 months prior' },
	{ session: 'November Session', deadline: 'September', recommended: '3 months prior' },
];

const publicCostTable = [
	{ level: 'Undergraduate Programs', myr: 'RM 9,800 - 22,050', bdt: 'BDT 253,820 - 571,095' },
	{ level: 'Postgraduate Programs', myr: 'RM 2,450 - 19,600', bdt: 'BDT 63,455 - 507,640' },
	{ level: 'PhD Programs', myr: 'RM 7,000 - 12,000', bdt: 'BDT 181,300 - 310,800' },
];

const privateCostTable = [
	{ level: 'Undergraduate Programs', myr: 'RM 6,615 - 45,570', bdt: 'BDT 171,329 - 1,180,263' },
	{ level: 'Postgraduate Programs', myr: 'RM 7,350 - 14,700', bdt: 'BDT 190,365 - 380,730' },
	{ level: 'PhD Programs', myr: 'RM 9,000 - 12,000', bdt: 'BDT 233,100 - 310,800' },
];

const scholarshipsList = [
	{
		title: 'Malaysian Technical Cooperation Programme (MTCP)',
		type: 'Government Full Scholarship',
		details: 'Covers full tuition fees and monthly allowances worth RM 3,500 (BDT 90,650), plus return economy airfare. Open for developing countries including Bangladesh.',
	},
	{
		title: 'Malaysia International Scholarship (MIS)',
		type: 'Government Award',
		details: 'Funded by the Ministry of Higher Education Malaysia for outstanding postgraduate and PhD candidates.',
	},
	{
		title: 'Commonwealth & University Merit Scholarships',
		type: 'Merit Fee Waiver (20% – 50%)',
		details: 'Direct waivers on first-year or entire tuition granted by institutions like Taylor’s, Sunway, APU, and INTI based on HSC/A-Level results.',
	},
	{
		title: 'Graduate Research & Teaching Assistantships',
		type: 'Stipend + Tuition Relief',
		details: 'Available for Master by Research and PhD students covering living stipends and research support.',
	},
];

const faqs = [
	{
		q: 'Can I study in Malaysia without IELTS from Bangladesh?',
		a: 'Yes, you can study in Malaysia without IELTS depending on your chosen university and academic stream. Many private institutions accept an English Medium of Instruction (MOI) certificate from your college/university or allow you to take an internal university English placement test upon arrival.',
	},
	{
		q: 'How long does it take to get a student visa (VAL) for Malaysia?',
		a: 'EMGS (Education Malaysia Global Services) typically processes the electronic Visa Approval Letter (eVAL) within 3 to 5 weeks once all verified documents and medical declarations are lodged. The subsequent Single Entry Visa takes roughly 3 to 7 working days.',
	},
	{
		q: 'Are Malaysian degrees recognized internationally and by employers?',
		a: 'Yes. Malaysian qualifications comply strictly with the Malaysian Qualifications Agency (MQA) and are globally recognized by employers, WES, and international credential evaluation boards. Dual-award programs also grant accredited UK or Australian university certifications.',
	},
	{
		q: 'Can I transfer credits from Malaysian universities to Australia, UK, or Canada?',
		a: 'Yes. Most universities offer 1+2, 2+1, or 2+2 credit transfer programs to partner universities in Australia, the UK, the US, and Canada, enabling you to save significant tuition fees before concluding your degree abroad.',
	},
	{
		q: 'What is the best time to apply for Malaysian universities?',
		a: 'It is highly recommended to apply at least 3 months prior to the course commencement. September/October is the primary intake offering the widest selection of programs, while February, April, and June offer additional flexible admission windows.',
	},
	{
		q: 'How much does it cost to study in Malaysia compared to Bangladesh?',
		a: 'The annual tuition fee in Malaysia is very close to private universities in Bangladesh (starting from RM 15,000 / ~BDT 3.9 Lac per year), but provides international campus life, high QS rankings, global exposure, and internationally transferable degrees.',
	},
	{
		q: 'Is Malaysia safe and welcoming for Bangladeshi students?',
		a: 'Yes. Malaysia is ranked the 2nd most peaceful country in Asia and 10th globally by the Global Peace Index. Bangladesh ranks 2nd in total international students in Malaysia, fostering a familiar, secure, and culturally comfortable environment with abundant halal cuisine.',
	},
	{
		q: 'Do I need to learn Bahasa Malaysia to study and live comfortably?',
		a: 'No. English is the official medium of instruction in international programs and is widely spoken in daily business, campus life, transit, and retail across Kuala Lumpur and other states.',
	},
];
---

<BaseLayout
	title="Study Destination Malaysia 2026/2027 | MSVC Official Guide"
	description="Comprehensive guide for Bangladeshi students to study in Malaysia. Explore top public & private universities, course fees in BDT, admission requirements, intakes, scholarships, and EMGS visa support."
>
	<!-- Hero Section -->
	<section class="relative overflow-hidden pt-12 pb-16 lg:pt-16 lg:pb-20 bg-linear-to-b from-white via-blue-50/20 to-slate-50 border-b border-slate-100">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl">
				<Badge
					variant="brand"
					size="sm"
					iconLeading={Sparkles}
					class="mb-4"
				>
					Study Destination Malaysia 2026 / 2027
				</Badge>
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-900 tracking-tight leading-[1.15] mb-6">
					Study in Malaysia <br class="hidden sm:inline" />
					<span class="text-brand-600">for Bangladeshi Students</span>
				</h1>
				<p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
					Malaysia has emerged as one of the most preferred study destinations for Bangladeshi students, offering world-class education at affordable costs. Currently hosting 170,000–200,000 international students with Bangladesh ranking 2nd worldwide.
				</p>
				<div class="flex flex-wrap items-center gap-4">
					<Button
						href={contactConfig.whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						variant="primary"
						size="lg"
						iconTrailing={ArrowRight}
					>
						Book Free Consultation
					</Button>
					<Button
						href="#universities"
						variant="outline"
						size="lg"
					>
						Explore Universities & Courses
					</Button>
				</div>
			</div>
		</div>
	</section>

	<!-- Sticky Quick Navigation Bar -->
	<div class="sticky top-16 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 py-3 shadow-xs">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5 text-xs font-semibold">
				{quickNavLinks.map((nav) => (
					<a
						href={nav.href}
						class="whitespace-nowrap px-3 py-1.5 rounded-lg text-slate-600 hover:text-brand-600 hover:bg-slate-100 transition-colors"
					>
						{nav.label}
					</a>
				))}
			</div>
		</div>
	</div>

	<!-- Key Overview Stats -->
	<section class="py-12 bg-white border-b border-slate-100">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
				<div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 card-shadow">
					<span class="text-3xl font-extrabold text-brand-600">#2</span>
					<h3 class="text-xs uppercase tracking-wider font-semibold text-slate-500 mt-1">Student Origin</h3>
					<p class="text-sm font-bold text-slate-900 mt-0.5">Bangladesh #2 Worldwide</p>
				</div>
				<div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 card-shadow">
					<span class="text-3xl font-extrabold text-brand-600">29</span>
					<h3 class="text-xs uppercase tracking-wider font-semibold text-slate-500 mt-1">QS Ranked Unis</h3>
					<p class="text-sm font-bold text-slate-900 mt-0.5">In World Top Rankings</p>
				</div>
				<div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 card-shadow">
					<span class="text-3xl font-extrabold text-brand-600">#2</span>
					<h3 class="text-xs uppercase tracking-wider font-semibold text-slate-500 mt-1">Peace Index</h3>
					<p class="text-sm font-bold text-slate-900 mt-0.5">2nd Most Peaceful in Asia</p>
				</div>
				<div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 card-shadow">
					<span class="text-3xl font-extrabold text-brand-600">590+</span>
					<h3 class="text-xs uppercase tracking-wider font-semibold text-slate-500 mt-1">Institutions</h3>
					<p class="text-sm font-bold text-slate-900 mt-0.5">Higher Education Centers</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Key Student Perks -->
	<section class="py-16 bg-slate-50 border-b border-slate-100">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
				{perks.map((p) => {
					const Icon = p.icon;
					return (
						<div class="bg-white p-6 rounded-2xl border border-slate-100 card-shadow card-hover flex flex-col justify-between">
							<div>
								<div class="w-11 h-11 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center mb-4">
									<Icon class="w-5 h-5" />
								</div>
								<h3 class="font-bold text-slate-900 text-base mb-1.5">{p.title}</h3>
								<p class="text-xs sm:text-sm text-slate-500 leading-relaxed">{p.desc}</p>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- 1. Why Study in Malaysia? -->
	<section class="py-20 bg-white" id="why-malaysia">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
				<div>
					<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Key Advantages</span>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Why Study in Malaysia?</h2>
					<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-2xl">
						Discover why thousands of Bangladeshi learners choose Malaysia for world-class qualifications, safety, and rapid career progression.
					</p>
				</div>
				<a
					href={contactConfig.whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors group"
				>
					<span>Consult with an Advisor</span>
					<ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{whyStudyMalaysia.map((item, idx) => (
					<div class="bg-slate-50 p-6 sm:p-7 rounded-2xl border border-slate-100 card-shadow card-hover flex flex-col justify-between">
						<div>
							<div class="w-9 h-9 rounded-xl bg-white text-brand-600 font-bold border border-slate-200 flex items-center justify-center text-xs mb-4">
								0{idx + 1}
							</div>
							<h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
							<p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{item.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 2. Top Universities in Malaysia (Moved earlier for discovery) -->
	<section class="py-20 bg-slate-50 border-t border-slate-100" id="universities">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
				<div>
					<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Global Rankings</span>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Top Universities in Malaysia</h2>
					<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-2xl">
						Featuring 29 QS World Ranked institutions across prestigious Public research universities, Private centres of excellence, and International Branch Campuses.
					</p>
				</div>
			</div>

			<div class="space-y-8">
				<!-- Public Universities -->
				<div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-100 card-shadow">
					<div class="flex items-center gap-3 mb-6">
						<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center">
							<Landmark class="w-5 h-5" />
						</div>
						<div>
							<h3 class="text-lg font-bold text-slate-900">Public Universities</h3>
							<p class="text-xs text-slate-500">Government research institutions with world-renowned faculties and affordable fees</p>
						</div>
					</div>

					<div class="overflow-x-auto rounded-xl bg-slate-50/50 border border-slate-100">
						<table class="w-full text-left text-sm border-collapse">
							<thead>
								<tr class="bg-slate-100/70 border-b border-slate-200/60 text-slate-700 font-semibold">
									<th class="py-3 px-4">University Name</th>
									<th class="py-3 px-4">QS World Rank</th>
									<th class="py-3 px-4">Institutional Profile</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{publicUniversities.map((u) => (
									<tr class="hover:bg-white transition-colors">
										<td class="py-3 px-4 font-semibold text-slate-900">{u.name}</td>
										<td class="py-3 px-4"><Badge variant="blue" size="xs">{u.rank}</Badge></td>
										<td class="py-3 px-4 text-slate-600 text-xs sm:text-sm">{u.note}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Private Universities & International Branch Campuses -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
					<!-- Private Universities -->
					<div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-100 card-shadow">
						<div class="flex items-center gap-3 mb-6">
							<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center">
								<GraduationCap class="w-5 h-5" />
							</div>
							<div>
								<h3 class="text-lg font-bold text-slate-900">Private Universities</h3>
								<p class="text-xs text-slate-500">Industry-aligned modern campuses with dual award degrees</p>
							</div>
						</div>
						<div class="space-y-3">
							{privateUniversities.map((u) => (
								<div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start justify-between gap-4">
									<div>
										<h4 class="font-bold text-slate-900 text-sm">{u.name}</h4>
										<p class="text-xs text-slate-500 mt-0.5">{u.note}</p>
									</div>
									<Badge variant="blue" size="xs" class="shrink-0">{u.rank}</Badge>
								</div>
							))}
						</div>
					</div>

					<!-- International Branch Campuses -->
					<div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-100 card-shadow">
						<div class="flex items-center gap-3 mb-6">
							<div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
								<Globe class="w-5 h-5" />
							</div>
							<div>
								<h3 class="text-lg font-bold text-slate-900">International Branch Campuses</h3>
								<p class="text-xs text-slate-500">UK and Australian universities awarding direct parent-institution degrees</p>
							</div>
						</div>
						<div class="space-y-3">
							{branchCampuses.map((u) => (
								<div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start justify-between gap-4">
									<div>
										<h4 class="font-bold text-slate-900 text-sm">{u.name}</h4>
										<p class="text-xs text-slate-500 mt-0.5">{u.note}</p>
									</div>
									<Badge variant="emerald" size="xs" class="shrink-0">{u.rank}</Badge>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. Top Courses & Popular Course Details and Fees -->
	<section class="py-20 bg-white border-t border-slate-100" id="courses">

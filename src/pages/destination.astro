<script>
	// Smooth open/close accordion animation
	const faqDetails = document.querySelectorAll<HTMLDetailsElement>('details.faq-item');

	faqDetails.forEach((targetDetail) => {
		const summary = targetDetail.querySelector('summary');
		const content = targetDetail.querySelector('.faq-content') as HTMLElement | null;

		if (!summary || !content) return;

		summary.addEventListener('click', (e) => {
			e.preventDefault();

			// If it's open, animate close
			if (targetDetail.open) {
				content.classList.remove('group-open:grid-rows-[1fr]');
				content.classList.add('grid-rows-[0fr]');
				targetDetail.classList.remove('open');
				
				// Wait for animation to finish before removing open attribute
				setTimeout(() => {
					targetDetail.removeAttribute('open');
				}, 280);
			} else {
				// Close other open accordions optionally for a clean look
				faqDetails.forEach((d) => {
					if (d !== targetDetail && d.open) {
						const otherContent = d.querySelector('.faq-content') as HTMLElement | null;
						if (otherContent) {
							otherContent.classList.remove('group-open:grid-rows-[1fr]');
							otherContent.classList.add('grid-rows-[0fr]');
						}
						setTimeout(() => {
							d.removeAttribute('open');
						}, 280);
					}
				});

				// Open target with animation
				targetDetail.setAttribute('open', '');
				// Small tick for CSS transition
				requestAnimationFrame(() => {
					content.classList.remove('grid-rows-[0fr]');
					content.classList.add('group-open:grid-rows-[1fr]');
				});
			}
		});
	});
</script>

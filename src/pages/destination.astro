			<div class="max-w-3xl mx-auto rounded-2xl bg-slate-50 border border-slate-100 p-8 sm:p-10 card-shadow">
				<div class="flex items-center gap-3 mb-6">
					<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center">
						<FileText class="w-5 h-5" />
					</div>
					<div>
						<h3 class="text-xl sm:text-2xl font-bold text-slate-900">Required Documents Checklist</h3>
						<p class="text-xs sm:text-sm text-slate-500">Prepare soft copies (PDF/Clear Scans) for immediate assessment</p>
					</div>
				</div>

				<ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-700">
					<li class="flex items-start gap-2.5">
						<CircleCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
						<span>Passport all pages (min. 18 months validity)</span>
					</li>
					<li class="flex items-start gap-2.5">
						<CircleCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
						<span>High School / HSC / O & A-Level Certificate & Transcripts</span>
					</li>
					<li class="flex items-start gap-2.5">
						<CircleCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
						<span>Passport-size photo with white background (35x45mm)</span>
					</li>
					<li class="flex items-start gap-2.5">
						<CircleCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
						<span>Bachelor Degree Certificate & Transcripts (for Master/PhD)</span>
					</li>
					<li class="flex items-start gap-2.5">
						<CircleCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
						<span>IELTS / TOEFL / PTE score sheet (if already taken)</span>
					</li>
					<li class="flex items-start gap-2.5">
						<CircleCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
						<span>Updated CV / Resume (for postgraduate applicants)</span>
					</li>
				</ul>

				<div class="mt-8 pt-6 border-t border-slate-200/60 flex flex-col sm:flex-row items-center justify-between gap-4">
					<span class="text-xs text-slate-500 text-center sm:text-left">
						Need help scanning or checking your certificate equivalents?
					</span>
					<Button
						href={contactConfig.whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						variant="primary"
						size="sm"
					>
						Send Documents via WhatsApp
					</Button>
				</div>
			</div>
		</div>
	</section>

	<!-- 10. Post-Study Work Opportunities in Malaysia -->
	<section class="py-20 bg-slate-50 border-t border-slate-100" id="work-opportunities">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
				<div>
					<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Career Horizons</span>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Post-Study Work Opportunities</h2>
					<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-2xl">
						Gain hands-on global professional exposure through part-time student work, corporate internships, and emerging tech hubs in Southeast Asia.
					</p>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
				<div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-100 card-shadow">
					<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center mb-4">
						<Briefcase class="w-5 h-5" />
					</div>
					<h3 class="text-lg font-bold text-slate-900 mb-2">Part-Time Work During Studies</h3>
					<p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-4">
						International students in Malaysia are permitted to work up to 20 hours per week during semester breaks and holidays of more than seven days in restaurants, petrol kiosks, mini markets, and hotels.
					</p>
					<ul class="text-xs sm:text-sm text-slate-600 space-y-2">
						<li class="flex items-center gap-2"><CircleCheck class="w-4 h-4 text-emerald-600 shrink-0" /> Supplement living costs during academic semesters</li>
						<li class="flex items-center gap-2"><CircleCheck class="w-4 h-4 text-emerald-600 shrink-0" /> Gain valuable cross-cultural work communication skills</li>
					</ul>
				</div>

				<div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-100 card-shadow">
					<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center mb-4">
						<Globe class="w-5 h-5" />
					</div>
					<h3 class="text-lg font-bold text-slate-900 mb-2">Post-Graduation Employment</h3>
					<p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-4">
						Malaysia serves as the regional headquarters for hundreds of Fortune 500 multinationals (MNCs) in Greater Kuala Lumpur, Cyberjaya, and Penang, generating high demand for bilingual engineering, software, and finance professionals.
					</p>
					<ul class="text-xs sm:text-sm text-slate-600 space-y-2">
						<li class="flex items-center gap-2"><CircleCheck class="w-4 h-4 text-emerald-600 shrink-0" /> Digital Economy (MDEC) & Tech Innovation Hubs</li>
						<li class="flex items-center gap-2"><CircleCheck class="w-4 h-4 text-emerald-600 shrink-0" /> Strategic stepping stone for ASEAN & global career mobility</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- 11. Frequently Asked Questions (FAQ) -->
	<section class="py-20 bg-white border-t border-slate-100" id="faq">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
				<div>
					<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Clarifications</span>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Frequently Asked Questions</h2>
					<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-2xl">
						Everything Bangladeshi students and parents need to know about Malaysian higher education and student visas.
					</p>
				</div>
			</div>

			<div class="max-w-4xl mx-auto space-y-4">
				{faqs.map((faq) => (
					<details class="group bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden card-shadow">
						<summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer select-none font-bold text-slate-900 text-sm sm:text-base hover:text-brand-600 transition-colors">
							<span>{faq.q}</span>
							<span class="w-7 h-7 rounded-full bg-white group-open:bg-blue-50 text-slate-500 group-open:text-brand-600 flex items-center justify-center shrink-0 ml-4 group-open:rotate-90 transition-transform border border-slate-200">
								<ChevronRight class="w-4 h-4" />
							</span>
						</summary>
						<div class="px-5 sm:px-6 pb-6 pt-1 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-200/50">
							{faq.a}
						</div>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- 12. Bottom Consultation Banner -->
	<section class="py-14 bg-brand-900 text-white relative overflow-hidden" id="consultation">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
				<div class="max-w-2xl">
					<span class="text-xs font-bold text-blue-300 tracking-wider uppercase mb-1.5 block">Direct Admission Assistance</span>
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight">
						Ready to Begin Your Malaysian Degree?
					</h2>
					<p class="text-blue-100/80 text-sm sm:text-base mt-2">
						Speak directly with an MSVC senior counselor on WhatsApp. We will evaluate your profile, recommend scholarship options, and guide you through the EMGS visa timeline.
					</p>
				</div>
				<div class="shrink-0 flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
					<Button
						href={contactConfig.whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						variant="primary"
						size="lg"
						class="w-full sm:w-auto justify-center bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-lg shadow-[#25D366]/30 active:scale-[0.98] border border-white/20"
					>
						<svg slot="leading" class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
							<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
						</svg>
						<span>Chat on WhatsApp</span>
					</Button>
					<Button
						href={`mailto:${contactConfig.email}?subject=Study%20in%20Malaysia%20Inquiry`}
						variant="outline"
						size="lg"
						iconLeading={Mail}
						class="w-full sm:w-auto justify-center bg-white/10 text-white hover:bg-white/20 border-white/20"
					>
						Email Us
					</Button>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

---

<html class="scroll-smooth" lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>MSVC | Malaysia Student Visa Consultancy</title>
		<meta
			name="description"
			content="MSVC - Malaysia Student Visa Consultancy. Your trusted gateway to higher education and visa assistance."
		/>
	</head>
	<body class="bg-[#F8FAFC] text-slate-800 font-sans antialiased selection:bg-brand-500 selection:text-white">
		<!-- BEGIN: MainHeader -->
		<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
				<!-- Brand Logo -->
				<a class="flex items-center gap-3 group" href="#">
					<div class="w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
						<GraduationCap className="w-5 h-5" />
					</div>
					<div class="flex flex-col">
						<span class="font-extrabold text-xl leading-none tracking-tight text-brand-900 select-none">EEDU POINT</span>
						<span class="text-[10px] text-slate-400 font-medium tracking-wider uppercase mt-1">Your Global Education Partner</span>
					</div>
				</a>

				<!-- Desktop Navigation Menu -->
				<nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
					<a class="text-brand-600 hover:text-brand-700 transition-colors" href="#">Home</a>
					<a class="hover:text-brand-600 transition-colors" href="#about">About</a>
					<div class="relative group cursor-pointer flex items-center gap-1 hover:text-brand-600">
						<span>Study Abroad</span>
						<ChevronDown className="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-600 transition-transform group-hover:rotate-180" />
					</div>
					<div class="relative group cursor-pointer flex items-center gap-1 hover:text-brand-600">
						<span>Services</span>
						<ChevronDown className="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-600 transition-transform group-hover:rotate-180" />
					</div>
					<a class="hover:text-brand-600 transition-colors" href="#blog">Blog</a>
					<a class="hover:text-brand-600 transition-colors" href="#contact">Contact</a>
				</nav>

				<!-- Right Header Actions -->
				<div class="flex items-center gap-3">
					<button aria-label="Search" class="w-9 h-9 rounded-full flex items-center justify-center text-slate-500 hover:text-brand-600 hover:bg-slate-50 transition-colors">
						<Search className="w-4 h-4" />
					</button>
					<a
						href="#consultation"
						class="rounded-full bg-brand-600 hover:bg-brand-700 text-white shadow-sm hover:shadow-md shadow-brand-600/20 font-semibold px-5 py-2 text-sm inline-flex items-center justify-center transition-all"
					>
						Book a Consultation
					</a>
				</div>
			</div>
		</header>
		<!-- END: MainHeader -->

		<main>
			<!-- BEGIN: HeroSection -->
			<section class="relative overflow-hidden pt-12 pb-20 lg:pt-16 lg:pb-28 bg-gradient-to-b from-white via-blue-50/20 to-[#F8FAFC]">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
						<!-- Left Hero Column -->
						<div class="lg:col-span-7 flex flex-col items-start z-10">
							<Badge variant="secondary" className="px-3.5 py-1.5 rounded-full bg-blue-100/70 border-blue-200/50 text-brand-700 text-xs font-bold tracking-wide uppercase mb-6">
								Study Abroad Consultancy
							</Badge>

							<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-900 tracking-tight leading-[1.15] mb-6">
								Your Dream to Study Abroad, <span class="text-brand-600">Our Priority</span>
							</h1>

							<p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mb-8">
								EEDU POINT helps you explore global education opportunities, find the right university, and build a brighter future — with expert guidance at every step.
							</p>

							<!-- CTA Buttons -->
							<div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-12">
								<a
									href="#consultation"
									class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-lg shadow-brand-600/25 transition-all"
								>
									<span>Get Free Consultation</span>
									<ArrowRight className="w-4 h-4 ml-2" />
								</a>
								<a
									href="#destinations"
									class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-semibold text-sm transition-all"
								>
									Explore Universities
								</a>
							</div>

							<!-- Stats Pill -->
							<div class="w-full sm:w-auto inline-flex flex-wrap items-center gap-6 sm:gap-10 p-4 sm:px-6 sm:py-3.5 rounded-2xl bg-white border border-slate-100 card-shadow">
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-brand-600">
										<GraduationCap className="w-5 h-5" />
									</div>
									<div>
										<div class="font-extrabold text-slate-900 text-base leading-none">10K+</div>
										<div class="text-[11px] text-slate-400 font-medium mt-1">Students Guided</div>
									</div>
								</div>
								<div class="h-8 w-px bg-slate-100 hidden sm:block"></div>
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-brand-600">
										<Building2 className="w-5 h-5" />
									</div>
									<div>
										<div class="font-extrabold text-slate-900 text-base leading-none">500+</div>
										<div class="text-[11px] text-slate-400 font-medium mt-1">Partner Universities</div>
									</div>
								</div>
								<div class="h-8 w-px bg-slate-100 hidden sm:block"></div>
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-brand-600">
										<ShieldCheck className="w-5 h-5" />
									</div>
									<div>
										<div class="font-extrabold text-slate-900 text-base leading-none">99%</div>
										<div class="text-[11px] text-slate-400 font-medium mt-1">Visa Success</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Right Hero Visual -->
						<div class="lg:col-span-5 flex justify-center items-center relative">
							<div class="relative w-full max-w-[420px] aspect-[4/5] flex items-center justify-center">
								<!-- Curved frame backdrop -->
								<div class="absolute inset-x-2 bottom-6 top-8 rounded-3xl overflow-hidden border border-white shadow-2xl">
									<img
										alt="Famous global university and landmarks backdrop"
										class="w-full h-full object-cover filter contrast-105 brightness-95 opacity-85"
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuANo7dVaYC5OaY8KsqWvAeW87mmuu8MhdNyz15XQ2EIQkM-GzokS0v2iV8pymzycVdmm_Y3qoAb3MSXuxmNfYXkXfqldtXwwDnvYDZje9bsIqbU33ZtYkQ4hpsljFFAxnyxyrmBWb_9wKOdIvrOWl9dmOc3bbgc_Z-vaHGZE-bW_FvEunz77sqy3SaaPICfYNzYTItg0VF_snxFjdL5PLbEdzVcxz6uZLvLB8G92jc"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-brand-900/40 via-transparent to-blue-900/10"></div>
								</div>
								<!-- Front Student Cutout -->
								<div class="relative z-10 w-4/5 h-full flex items-end justify-center">
									<img
										alt="Smiling International Student"
										class="w-full h-[90%] object-cover object-top rounded-2xl shadow-xl border-4 border-white transform transition-transform hover:scale-[1.02] duration-300"
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQKfR7tUsRkBWq9nnR0Fma_fxBKkJxx6yzb23Gz92TknEe8qxCAgbEF-nur9Ej2m0ilbDYg9i1fIxCtD5nFKvY0pbmh4PvrJn3lRUy6CoJfWfufghAxiHSNOnVGf2Py9NMQaYFMFGGJ0AGAyt9rA-awgOESweAtpSklVk94-WjxMrQCWh2aYVViPJYruoqPmfxN2QVYJCJAuSuggGUVjHRwHeMeSlfy9Ib8JeybPM"
									/>
									<div class="absolute bottom-10 left-4 bg-brand-600 text-white font-bold text-xs px-3.5 py-1.5 rounded-lg shadow-md flex items-center gap-1.5">
										<BookOpen className="w-3.5 h-3.5" />
										<span>EEDU POINT</span>
									</div>
								</div>
								<!-- Floating Handwritten Badge -->
								<div class="absolute -top-3 -right-3 sm:right-2 z-20 bg-white/95 backdrop-blur-sm px-4 py-2.5 rounded-2xl shadow-lg border border-slate-100 text-center transform rotate-6">
									<span class="font-handwriting text-brand-600 text-xl font-bold block leading-tight">Better Education<br /><span class="text-brand-900">Brighter Future</span></span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
			<!-- END: HeroSection -->

			<!-- BEGIN: PopularDestinations -->
			<section class="py-20 bg-white border-t border-slate-100" id="destinations">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
						<div>
							<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Study Abroad</span>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Popular Destinations</h2>
							<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-xl">
								Explore top study destinations and find the perfect country for your academic journey.
							</p>
						</div>
						<a class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors group" href="#">
							<span>View All Countries</span>
							<ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
						</a>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
						{destinations.map((item) => (
							<Card className="rounded-2xl border-slate-100 card-shadow card-hover overflow-hidden flex flex-col group p-0">
								<div class="h-36 overflow-hidden relative">
									<img
										alt={item.country}
										class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
										src={item.image}
									/>
								</div>
								<CardContent className="p-4 flex flex-col flex-1 justify-between">
									<div>
										<div class="flex items-center gap-2 mb-2">
											<span class="text-base leading-none">{item.flag}</span>
											<h3 class="font-bold text-slate-900 text-base">{item.country}</h3>
										</div>
										<p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">{item.tagline}</p>
									</div>
									<div class="pt-4 flex justify-end">
										<span class="w-7 h-7 rounded-full bg-slate-50 group-hover:bg-brand-600 group-hover:text-white flex items-center justify-center text-slate-400 text-xs transition-colors">
											<ArrowRight className="w-3.5 h-3.5" />
										</span>
									</div>
								</CardContent>
							</Card>
						))}
					</div>
				</div>
			</section>
			<!-- END: PopularDestinations -->

			<!-- BEGIN: ServicesSection -->
			<section class="py-20 bg-[#F8FAFC]" id="services">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-12 gap-12 items-center">
						<div class="lg:col-span-4">
							<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Our Services</span>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
								Comprehensive Study Abroad Solutions
							</h2>
							<p class="text-slate-500 text-sm sm:text-base leading-relaxed mb-8">
								From initial counseling to post-arrival support, we provide complete, step-by-step assistance to make your journey hassle-free.
							</p>
							<a
								href="#consultation"
								class="rounded-full bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm px-6 py-2.5 inline-flex items-center justify-center transition-all"
							>
								<span>All Services</span>
								<ArrowRight className="w-4 h-4 ml-2" />
							</a>
						</div>

						<div class="lg:col-span-8">
							<div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
								{services.map((service) => {
									const Icon = service.icon;
									return (
										<div class="bg-white p-5 rounded-2xl border border-slate-100 card-shadow card-hover flex flex-col justify-between">

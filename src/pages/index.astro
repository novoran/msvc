---

<html class="scroll-smooth" lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>MSVC | Malaysia Student Visa Consultancy</title>
		<meta
			name="description"
			content="MSVC (Malaysia Student Visa Consultancy) is your trusted advisor for university admissions, EMGS visa approval, and global study guidance."
		/>
	</head>
	<body class="bg-[#F8FAFC] text-slate-800 font-sans antialiased selection:bg-brand-500 selection:text-white">
		<Header />

		<main>
			<!-- BEGIN: HeroSection -->
			<section class="relative overflow-hidden pt-12 pb-20 lg:pt-16 lg:pb-28 bg-gradient-to-b from-white via-blue-50/20 to-[#F8FAFC]">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
						<!-- Left Hero Column -->
						<div class="lg:col-span-7 flex flex-col items-start z-10">
							<!-- Badge -->
							<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/70 border border-blue-200/50 text-brand-700 text-xs font-bold tracking-wide uppercase mb-6">
								Malaysia Student Visa Consultancy
							</div>

							<!-- Headline -->
							<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-900 tracking-tight leading-[1.15] mb-6">
								Your Dream to Study in Malaysia, <span class="text-brand-600">Our Priority</span>
							</h1>

							<!-- Subtitle -->
							<p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mb-8">
								MSVC provides complete guidance for international admissions, EMGS student pass applications, and visa documentation for accredited Malaysian institutions.
							</p>

							<!-- CTA Buttons -->
							<div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-12">
								<a
									href="#consultation"
									class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-brand-600 text-white font-semibold text-sm hover:bg-brand-700 shadow-lg shadow-brand-600/25 transition-all"
								>
									<span>Get Free Consultation</span>
									<ArrowRight class="w-4 h-4" />
								</a>
								<a
									href="#destinations"
									class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-white border border-slate-200 text-slate-700 font-semibold text-sm hover:border-slate-300 hover:bg-slate-50 transition-all"
								>
									Explore Universities
								</a>
							</div>

							<!-- Stats Bar -->
							<div class="w-full sm:w-auto inline-flex flex-wrap items-center gap-6 sm:gap-10 p-4 sm:px-6 sm:py-3.5 rounded-2xl bg-white border border-slate-100 card-shadow">
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-brand-600">
										<GraduationCap class="w-5 h-5" />
									</div>
									<div>
										<div class="font-extrabold text-slate-900 text-base leading-none">10K+</div>
										<div class="text-xs text-slate-500 font-medium mt-1">Students Guided</div>
									</div>
								</div>
								<div class="hidden sm:block w-px h-8 bg-slate-200"></div>
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-brand-600">
										<Building class="w-5 h-5" />
									</div>
									<div>
										<div class="font-extrabold text-slate-900 text-base leading-none">100+</div>
										<div class="text-xs text-slate-500 font-medium mt-1">Partner Institutions</div>
									</div>
								</div>
								<div class="hidden sm:block w-px h-8 bg-slate-200"></div>
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-brand-600">
										<ShieldCheck class="w-5 h-5" />
									</div>
									<div>
										<div class="font-extrabold text-slate-900 text-base leading-none">99%</div>
										<div class="text-xs text-slate-500 font-medium mt-1">Visa Success</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Right Hero Column (Visual Composition) -->
						<div class="lg:col-span-5 relative flex justify-center items-center">
							<!-- Decorative Backing Architecture Composition -->
							<div class="relative w-full max-w-[460px] aspect-[4/5] flex items-center justify-center">
								<!-- Subtle Background Glow -->
								<div class="absolute inset-0 bg-blue-100/60 rounded-full filter blur-3xl transform -translate-y-4"></div>
								<!-- Collage Architecture Landmark Backdrop -->
								<div class="absolute inset-x-2 bottom-6 top-8 rounded-3xl overflow-hidden border border-white shadow-2xl">
									<img
										alt="Famous global university and landmarks backdrop"
										class="w-full h-full object-cover filter contrast-105 brightness-95 opacity-85"
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuANo7dVaYC5OaY8KsqWvAeW87mmuu8MhdNyz15XQ2EIQkM-GzokS0v2iV8pymzycVdmm_Y3qoAb3MSXuxmNfYXkXfqldtXwwDnvYDZje9bsIqbU33ZtYkQ4hpsljFFAxnyxyrmBWb_9wKOdIvrOWl9dmOc3bbgc_Z-vaHGZE-bW_FvEunz77sqy3SaaPICfYNzYTItg0VF_snxFjdL5PLbEdzVcxz6uZLvLB8G92jc"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-brand-900/40 via-transparent to-blue-900/10"></div>
								</div>
								<!-- Front Student Cutout -->
								<div class="relative z-10 w-4/5 h-full flex items-end justify-center">
									<img
										alt="Smiling International Student"
										class="w-full h-[90%] object-cover object-top rounded-2xl shadow-xl border-4 border-white transform transition-transform hover:scale-[1.02] duration-300"
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQKfR7tUsRkBWq9nnR0Fma_fxBKkJxx6yzb23Gz92TknEe8qxCAgbEF-nur9Ej2m0ilbDYg9i1fIxCtD5nFKvY0pbmh4PvrJn3lRUy6CoJfWfufghAxiHSNOnVGf2Py9NMQaYFMFGGJ0AGAyt9rA-awgOESweAtpSklVk94-WjxMrQCWh2aYVViPJYruoqPmfxN2QVYJCJAuSuggGUVjHRwHeMeSlfy9Ib8JeybPM"
									/>
									<!-- Brand Notebook Badge Overlay -->
									<div class="absolute bottom-10 left-4 bg-brand-600 text-white font-bold text-xs px-3.5 py-1.5 rounded-lg shadow-md flex items-center gap-1.5">
										<BookOpen class="w-3.5 h-3.5" />
										<span>MSVC</span>
									</div>
								</div>
								<!-- Floating Handwritten Badge -->
								<div class="absolute -top-3 -right-3 sm:right-2 z-20 bg-white/95 backdrop-blur-sm px-4 py-2.5 rounded-2xl shadow-lg border border-slate-100 text-center transform rotate-6">
									<span class="font-handwriting text-brand-600 text-xl font-bold block leading-tight">Better Education<br /><span class="text-brand-900">Brighter Future</span></span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
			<!-- END: HeroSection -->

			<!-- BEGIN: PopularDestinations -->
			<section class="py-20 bg-white border-t border-slate-100" id="destinations">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
						<div>
							<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Study Abroad</span>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Popular Destinations</h2>
							<p class="text-slate-500 text-sm sm:text-base mt-2 max-w-xl">
								Explore top study destinations and find the perfect country for your academic journey.
							</p>
						</div>
						<a class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors group" href="#">
							<span>View All Countries</span>
							<ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
						</a>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
						{destinations.map((d) => (
							<div class="bg-white rounded-2xl border border-slate-100 card-shadow card-hover overflow-hidden flex flex-col group">
								<div class="h-36 overflow-hidden relative">
									<img
										alt={d.country}
										class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
										src={d.image}
									/>
								</div>
								<div class="p-4 flex flex-col flex-1 justify-between">
									<div>
										<div class="flex items-center gap-2 mb-2">
											<span class="text-base leading-none">{d.flag}</span>
											<h3 class="font-bold text-slate-900 text-base">{d.country}</h3>
										</div>
										<p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">{d.tagline}</p>
									</div>
									<div class="pt-4 flex justify-end">
										<span class="w-7 h-7 rounded-full bg-slate-50 group-hover:bg-brand-600 group-hover:text-white flex items-center justify-center text-slate-400 text-xs transition-colors">
											<ArrowRight class="w-3.5 h-3.5" />
										</span>
									</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
			<!-- END: PopularDestinations -->

			<!-- BEGIN: ServicesSection -->
			<section class="py-20 bg-[#F8FAFC]" id="services">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-12 gap-12 items-start">
						<div class="lg:col-span-4">
							<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Our Services</span>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
								Complete Support for Your Study Abroad Journey
							</h2>
							<p class="text-slate-500 text-sm sm:text-base leading-relaxed mb-8">
								From Malaysian university selection to EMGS student pass approval, we provide end-to-end support to make your dream a reality.
							</p>
							<a class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-600 text-white font-semibold text-sm hover:bg-brand-700 shadow-md shadow-brand-600/20 transition-all" href="#">
								<span>Explore Our Services</span>
								<ArrowRight class="w-4 h-4" />
							</a>
						</div>

						<div class="lg:col-span-8">
							<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
								{services.map((s) => {
									const Icon = s.icon;
									return (
										<div class="bg-white p-5 rounded-2xl border border-slate-100 card-shadow card-hover flex flex-col justify-between">
											<div>
												<div class="w-11 h-11 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center text-base mb-4">
													<Icon class="w-5 h-5" />
												</div>
												<h3 class="font-bold text-slate-900 text-sm leading-snug mb-1">{s.title}</h3>
												<p class="text-xs text-slate-500 leading-relaxed">{s.desc}</p>
											</div>
										</div>
									);
								})}
							</div>
						</div>
					</div>
				</div>
			</section>
			<!-- END: ServicesSection -->

			<!-- BEGIN: WhyChooseUs -->
			<section class="py-20 bg-white border-t border-slate-100 overflow-hidden" id="about">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-12 gap-12 items-center">
						<div class="lg:col-span-7">
							<span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Why Choose MSVC</span>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
								Your Success is Our Commitment
							</h2>
							<p class="text-slate-500 text-sm sm:text-base leading-relaxed mb-8 max-w-xl">
								We go beyond consultancy — we become your dedicated education partner in Malaysia, offering personalized guidance, direct university partnerships, and end-to-end visa tracking.
							</p>

							<div class="grid sm:grid-cols-2 gap-6 mb-8">
								<div class="flex items-start gap-4">
									<div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center shrink-0">
										<UserCheck class="w-5 h-5" />
									</div>
									<div>
										<h4 class="font-bold text-slate-900 text-sm mb-1">Official EMGS Guidance</h4>
										<p class="text-xs text-slate-500 leading-relaxed">Direct consultation on VAL approvals, medical clearance, and immigration rules.</p>
									</div>
								</div>
								<div class="flex items-start gap-4">

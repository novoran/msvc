<html class="scroll-smooth" lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>MSVC | Malaysia Student Visa Consultancy</title>
		<meta
			name="description"
			content="MSVC (Malaysia Student Visa Consultancy) is your trusted advisor for university admissions, EMGS visa approval, and global study guidance."
		/>
	</head>
	<body class="bg-[#F8FAFC] text-slate-800 font-sans antialiased selection:bg-brand-500 selection:text-white">
		<Header />

		<main>
			<Hero />
			<PopularDestinations destinations={destinations} />
			<Services services={services} />
			<WhyChooseUs />
			<Testimonials testimonials={testimonials} />
			<CtaBanner />
			<LatestUpdates blogPosts={blogPosts} />
		</main>

		<Footer />
	</body>
</html>
